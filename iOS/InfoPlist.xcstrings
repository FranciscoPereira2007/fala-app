{
  "sourceLanguage": "pt-PT",
  "version": "1.0",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ouvires a tua voz e transformá-la em texto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To hear your voice and turn it into text."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour entendre ta voix et la transformer en texte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para oír tu voz y convertirla en texto."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tirares uma foto e a mandares no chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To take a photo and send it in the chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour prendre une photo et l'envoyer dans le chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para hacer una foto y enviarla en el chat."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mostrar o texto enquanto falas. A transcrição corre no teu iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show the text while you talk. Transcription runs on your iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour afficher le texte pendant que tu parles. La transcription tourne sur ton iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mostrar el texto mientras hablas. La transcripción corre en tu iPhone."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para enviar o texto para o teu Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To send the text to your Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour envoyer le texte à ton Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para enviar el texto a tu Mac."
          }
        }
      }
    }
  }
}