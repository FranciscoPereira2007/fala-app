    "Aplica uma Transform para reescrever, limpar ou reorganizar texto depois de ditares. Corre no teu Mac, grátis.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply a Transform to rewrite, clean up or reorganize text after you dictate. Runs on your Mac, free."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applique une Transform pour réécrire, nettoyer ou réorganiser le texte après la dictée. Tourne sur ton Mac, gratuit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica una Transform para reescribir, limpiar o reorganizar el texto después de dictar. Corre en tu Mac, gratis."
          }
        }
      }
    },
