          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " y términos del sector."
          }
        }
      }
    },
    " e vê aparecer como magia ✨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and watch it appear like magic ✨"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " et regarde apparaître comme par magie ✨"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " y míralo aparecer como por arte de magia ✨"
          }
        }
      }
    },
