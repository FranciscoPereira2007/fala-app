    "Segura a tecla fn enquanto falas. Larga, e o texto aparece onde está o cursor. Para mãos livres, clica no pill em baixo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the fn key while you talk. Let go and the text appears at the cursor. For hands-free, click the pill at the bottom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la touche fn pendant que tu parles. Relâche et le texte apparaît au curseur. Mains libres : clique sur la pilule en bas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la tecla fn mientras hablas. Suelta y el texto aparece donde está el cursor. Manos libres: haz clic en la píldora de abajo."
          }
        }
      }
    },
