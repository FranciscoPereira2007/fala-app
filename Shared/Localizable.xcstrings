    "Clica na caixa, segura fn e diz: \"Olá, isto é a Fala.\"": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the box, hold fn and say: \"Hi, this is Fala.\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique dans la case, maintiens fn et dis : « Bonjour, c'est Fala. »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la caja, mantén fn y di: «Hola, esto es Fala»."
          }
        }
      }
    },
