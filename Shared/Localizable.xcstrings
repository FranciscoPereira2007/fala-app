    "A sessão está ocupada. Mandar na mesma? Fica na fila do agente.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session is busy. Send anyway? It goes into the agent's queue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session est occupée. Envoyer quand même ? Ça entre dans la file de l'agent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión está ocupada. ¿Enviar igualmente? Queda en la cola del agente."
