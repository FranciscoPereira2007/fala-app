      }
    },
    "Com todo o computador, o Jarvis abre apps, mexe nos teus projetos e manda nas outras sessões, como o Dot. Pede sempre confirmação antes de apagar, pagar ou enviar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With full computer access, Jarvis opens apps, works on your projects and directs your other sessions, like Dot. It always asks before deleting, paying or sending."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec tout l'ordinateur, Jarvis ouvre des apps, touche à tes projets et dirige tes autres sessions, comme Dot. Il demande toujours avant de supprimer, payer ou envoyer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con todo el ordenador, Jarvis abre apps, toca tus proyectos y dirige tus otras sesiones, como Dot. Siempre pide confirmación antes de borrar, pagar o enviar."
          }
        }
      }
    },
