    "Com qual destas te identificas?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which of these sounds like you?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans lequel de ces profils te reconnais-tu ?"
          }
