          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet today. Tap Mac and say your first sentence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien encore aujourd'hui. Touche Mac et dis ta première phrase."
