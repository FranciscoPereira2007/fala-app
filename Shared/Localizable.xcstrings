    "A Fala usa este estilo em todos os ditados. Podes mudar quando quiseres.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fala uses this style in every dictation. You can change it anytime."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fala utilise ce style dans toutes tes dictées. Tu peux le changer quand tu veux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fala usa este estilo en todos tus dictados. Puedes cambiarlo cuando quieras."
          }
        }
      }
    },
    "A Transform funciona onde escreves": {
      "localizations": {
        "en": {
