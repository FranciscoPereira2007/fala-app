    "Com a Fala ligada: 1.º toque grava, 2.º cola no computador. Não sai da app onde estás.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Fala on: 1st tap records, 2nd pastes on the computer. You never leave the app you're in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Fala activée : 1re touche enregistre, 2e colle sur l'ordinateur. Tu ne quittes pas l'app où tu es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Fala activada: el 1.er toque graba, el 2.º pega en el ordenador. No sales de la app en la que estás."
          }
        }
