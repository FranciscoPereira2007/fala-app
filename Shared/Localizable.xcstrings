    "ABC": {},
    "Abre a Fala no Mac. Depois, na aba Mac, falas aqui e o texto aparece lá.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Fala on the Mac. Then, in the Mac tab, talk here and the text shows up there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Fala sur le Mac. Ensuite, dans l'onglet Mac, parle ici et le texte apparaît là-bas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Fala en el Mac. Luego, en la pestaña Mac, habla aquí y el texto aparece allí."
          }
        }
      }
    },
    "Abre a Fala para começar a ditar": {
      "localizations": {
        "en": {
          "stringUnit": {
