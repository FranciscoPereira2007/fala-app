    "Volta à app onde estavas: toca em ◀ no canto superior esquerdo. A partir de agora ditas sem sair dela.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back to the app you were in: tap ◀ in the top left corner. From now on you dictate without leaving it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviens à l'app où tu étais : touche ◀ en haut à gauche. Désormais tu dictes sans la quitter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a la app donde estabas: toca ◀ en la esquina superior izquierda. A partir de ahora dictas sin salir de ella."
          }
        }
      }
    },
