    "Abre a Fala no iPhone, aba Mac. Falas lá e o texto cola aqui, onde estiver o cursor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Fala on the iPhone, Mac tab. Talk there and the text pastes here, at the cursor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Fala sur l'iPhone, onglet Mac. Parle là-bas et le texte se colle ici, au curseur."
