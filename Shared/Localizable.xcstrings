    "Aponta a câmara do iPhone ao QR e toca em Abrir na Fala. Fica ligado para sempre.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the iPhone camera at the QR and tap Open in Fala. It stays connected for good."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointe la caméra de l'iPhone vers le QR et touche Ouvrir dans Fala. La connexion reste pour toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara del iPhone al QR y toca Abrir en Fala. Queda conectado para siempre."
          }
        }
      }
    },
