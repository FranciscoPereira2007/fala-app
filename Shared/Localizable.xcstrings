          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voix basique. Pour la voix naturelle et gratuite : Réglages › Accessibilité › Contenu énoncé › Voix › Portugais › Voix › Joana (améliorée)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voz básica. Para la voz natural y gratis: Ajustes › Accesibilidad › Contenido leído › Voces › Portugués › Voz › Joana (mejorada)."
