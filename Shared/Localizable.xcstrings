    "A tua voz é transcrita no teu Mac ou no teu iPhone. Nada é guardado em servidores.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice is transcribed on your Mac or your iPhone. Nothing is stored on servers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta voix est transcrite sur ton Mac ou ton iPhone. Rien n'est gardé sur des serveurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz se transcribe en tu Mac o en tu iPhone. No se guarda nada en servidores."
          }
        }
      }
    },
