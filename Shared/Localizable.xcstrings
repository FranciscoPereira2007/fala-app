{
  "sourceLanguage": "pt-PT",
  "strings": {
    " Diz o gatilho e aparece tudo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Say the trigger and it all appears."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Dis le déclencheur et tout apparaît."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Di el disparador y aparece todo."
          }
        }
      }
    },
    " a Fala": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Fala"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Fala"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Fala"
          }
        }
      }
    },
    " e fala": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and talk"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " et parle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " y habla"
          }
        }
      }
    },
    " e termos da área.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and industry terms."
          }
        },
        "fr": {
