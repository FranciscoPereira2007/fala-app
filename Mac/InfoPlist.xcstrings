{
  "sourceLanguage": "pt-PT",
  "version": "1.0",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ouvires a tua voz e transformá-la em texto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To hear your voice and turn it into text."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour entendre ta voix et la transformer en texte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para oír tu voz y convertirla en texto."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tirares uma foto e a mandares no chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To take a photo and send it in the chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour prendre une photo et l'envoyer dans le chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para hacer una foto y enviarla en el chat."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição corre no teu Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription runs on your Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription tourne sur ton Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción corre en tu Mac."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber texto do teu iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To receive text from your iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir le texte de ton iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir texto de tu iPhone."
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escrever nas tuas sessões do Claude e do Codex no Terminal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To type into your Claude and Codex sessions in Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour écrire dans tes sessions Claude et Codex dans le Terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escribir en tus sesiones de Claude y Codex en el Terminal."
          }
        }
      }
    }
  }
